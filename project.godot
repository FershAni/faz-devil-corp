[layer_names]

2d_physics/layer_1="World"
2d_navigation/layer_1="Ground"
2d_physics/layer_2="Players"
2d_navigation/layer_2="HazardWater"
2d_physics/layer_3="Props"
2d_physics/layer_4="Scrap"
2d_physics/layer_5="Interactables"
3d_physics/layer_6="Equipment"

[physics]

common/physics_ticks_per_second=30
3d/physics_engine="Jolt Physics"
3d/default_gravity=18.0

[rendering]

rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
