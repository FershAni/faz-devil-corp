lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_bands=24
rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
scaling_3d/scale.android=0.8
anti_aliasing/quality/msaa_3d.android=0
