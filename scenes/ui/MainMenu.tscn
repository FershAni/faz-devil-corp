[node name="Way1" type="Label" parent="Help/Root/Center/Panel/Margin/Column"]
custom_minimum_size = Vector2(640, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "1. Steam (лучший способ). Ты жмёшь «Создать игру» и выбираешь слот. У друга: «Подключиться» -> «Найти лобби» -> «Друзья» -> выбрать тебя -> «Войти». Никаких IP и настроек роутера."
autowrap_mode = 3

[node name="Way2" type="Label" parent="Help/Root/Center/Panel/Margin/Column"]
custom_minimum_size = Vector2(640, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 15
text = "2. Пригласить: хост открывает «Найти лобби» -> «Друзья», выбирает друга со статусом «онлайн» и жмёт «ПРИГЛАСИТЬ». Затем выбирает слот кампании. Другу надо уже сидеть в игре: приглашение приходит ей, и он жмёт «Войти». Оверлей Steam (Shift+Tab) доступен только при запуске из Steam."
autowrap_mode = 3

[node name="Rules" type="Label" parent="Help/Root/Center/Panel/Margin/Column"]
custom_minimum_size = Vector2(640, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.52, 0.5, 0.5, 1)
theme_override_font_sizes/font_size = 13
text = "Хост создал лобби - друг заходит через «Найти лобби» -> «Друзья» -> «Войти», и карта грузится у обоих. Пауза в игре локальная: мир не останавливается, напарники продолжают слышать шаги. Выйти из игры можно через Esc -> «ВЫЙТИ ИЗ ИГРЫ»."
autowrap_mode = 3

[node name="CloseHelp" type="Button" parent="Help/Root/Center/Panel/Margin/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "ПОНЯТНО"

[node name="Settings" parent="." instance=ExtResource("2_settings_menu")]
